#!/usr/bin/env bash
# plantao nova <nome> | ligar <nome> | reabrir <nome> | desligar <nome> | fallback <nome> codex|nenhum | status
set -euo pipefail
RAIZ="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
cmd="${1:-status}"; nome="${2:-}"

case "$cmd" in
  nova)
    [ -n "$nome" ] && [ ! -e "$RAIZ/quests/$nome" ] || { echo "nome vazio ou já existe"; exit 1; }
    cp -r "$RAIZ/quests/_modelo" "$RAIZ/quests/$nome"
    echo "edite quests/$nome/QUEST.md e rode: plantao ligar $nome" ;;
  ligar)
    sed -i 's/^status: .*/status: ativa/' "$RAIZ/quests/$nome/QUEST.md"
    systemctl --user enable --now "plantao@$nome" ;;
  reabrir)
    # Rejeita a rodada: guarda o resultado, abre sessão limpa e cria a seção de revisão
    q="$RAIZ/quests/$nome"; [ -f "$q/QUEST.md" ] || { echo "quest não existe"; exit 1; }
    systemctl --user stop "plantao@$nome" 2>/dev/null || true
    n=1; while [ -e "$q/resultados-r$n" ]; do n=$((n + 1)); done
    [ -d "$q/resultados" ] && cp -r "$q/resultados" "$q/resultados-r$n"
    rm -f "$q/.sessao" "$q/.iniciada" "$q/.codex-sessao"
    sed -i 's/^status: .*/status: pausada/' "$q/QUEST.md"
    printf '\n# Revisão %s\n\n' "$n" >> "$q/QUEST.md"
    echo "$(date '+%F %H:%M') · sistema · reaberta, rodada anterior guardada em resultados-r$n" >> "$q/diario.md"
    echo "escreva o que mudar em QUEST.md (Revisão $n) e rode: plantao ligar $nome" ;;
  desligar)
    sed -i 's/^status: ativa/status: pausada/' "$RAIZ/quests/$nome/QUEST.md"
    systemctl --user disable --now "plantao@$nome" ;;
  fallback)
    q="$RAIZ/quests/$nome/QUEST.md"; [ -f "$q" ] || { echo "quest não existe"; exit 1; }
    case "${3:-}" in
      codex) modo=sim ;;
      nenhum) modo=nao ;;
      *) echo "uso: plantao fallback <nome> codex|nenhum"; exit 1 ;;
    esac
    if grep -q '^codex:' "$q"; then
      sed -i "s/^codex: .*/codex: $modo/" "$q"
    else
      sed -i "1a codex: $modo" "$q"
    fi
    echo "fallback de $nome: ${3} (serviços já em execução usam a nova regra após reiniciar)" ;;
  status)
    for q in "$RAIZ"/quests/*/; do
      n=$(basename "$q"); [ "$n" = _modelo ] && continue
      printf '%-20s %-10s %s\n' "$n" "$(sed -n 's/^status: //p' "$q/QUEST.md")" \
        "$(systemctl --user is-active "plantao@$n" 2>/dev/null || true)"
    done ;;
  *) echo "uso: plantao nova|ligar|reabrir|desligar|fallback|status [nome]"; exit 1 ;;
esac
